<script>

    /*
     * NAVIGATION BACKGROUND
     */

    window.addEventListener("scroll", function () {

        const nav = document.getElementById("navbar");

        if (window.scrollY > 40) {

            nav.classList.add("scrolled");

        } else {

            nav.classList.remove("scrolled");

        }

    });



    /*
     * COPY SERVER IP
     */

    function copyIP() {

        const ip = "play.mc-kingdom.net";

        navigator.clipboard.writeText(ip);

        const button =
            document.getElementById("copyButton");

        button.textContent = "COPIED!";

        setTimeout(function () {

            button.textContent = "COPY IP";

        }, 2000);

    }



    /*
     * OPTIONAL SERVER STATUS
     *
     * Uses the public Minecraft Server Status API.
     * Remove this section if you don't want it.
     */

    async function getServerStatus() {

        try {

            const response = await fetch(
                "https://api.mcsrvstat.us/3/play.mc-kingdom.net"
            );

            const data = await response.json();

            const playerCount =
                document.getElementById("playerCount");

            if (data.online) {

                playerCount.textContent =
                    data.players.online;

            } else {

                playerCount.textContent =
                    "OFFLINE";

            }

        } catch (error) {

            document.getElementById(
                "playerCount"
            ).textContent = "ONLINE";

        }

    }


    getServerStatus();

</script>

