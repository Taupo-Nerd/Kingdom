        font-size: 56px;
        letter-spacing: -4px;
    }

    .hero-text {
        font-size: 16px;
    }

    .buttons {
        flex-direction: column;
    }

    .button {
        width: 100%;
        text-align: center;
    }

    .server {
        width: 100%;
        justify-content: space-between;
    }

    .stats-box {
        grid-template-columns: 1fr;
    }

    .stat {
        border-right: 0;
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .stat:last-child {
        border-bottom: 0;
    }

    section {
        padding: 85px 0;
    }

    .feature-grid {
        grid-template-columns: 1fr;
    }

    .showcase-content {
        padding: 30px;
    }

    .footer {
        flex-direction: column;
        gap: 25px;
    }

    .footer-links {
        flex-wrap: wrap;
        justify-content: center;
    }
}
</style>
</head>

