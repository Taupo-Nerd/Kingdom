/* COPY SERVER IP */

function copyIP() {

    navigator.clipboard.writeText(
        "play.mc-kingdom.net"
    );

    const button =
        document.getElementById("copyButton");

    button.innerText = "COPIED!";

    setTimeout(function() {

        button.innerText = "COPY IP";

    }, 2000);

}


/* LIVE SERVER PLAYER COUNT */

async function serverStatus() {

    try {

        const response = await fetch(
            "https://api.mcsrvstat.us/3/play.mc-kingdom.net"
        );

        const data = await response.json();

        const players =
            document.getElementById("players");

        if (data.online) {

            players.innerText =
                data.players.online;

        } else {

            players.innerText =
                "OFFLINE";

        }

    } catch (error) {

        document.getElementById("players").innerText =
            "ONLINE";

    }

}

serverStatus();

