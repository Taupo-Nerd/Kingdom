<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MC Kingdom | Premier Cobblemon Server</title>

    <meta name="description"
          content="MC Kingdom is a premier Cobblemon Minecraft server. Explore, catch Pokémon, build your kingdom, battle trainers and join a growing community.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Montserrat:wght@700;800;900&display=swap"
          rel="stylesheet">

    <style>

        /* =========================================================
           GLOBAL
        ========================================================= */

        :root {
            --gold: #f5c451;
            --gold-light: #ffe49a;
            --gold-dark: #b9861f;

            --bg: #07090d;
            --bg-2: #0c1017;
            --bg-3: #111722;

            --text: #ffffff;
            --muted: #9ba4b5;

            --border: rgba(255,255,255,0.09);

            --radius: 18px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: "Inter", sans-serif;
            overflow-x: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button {
            font-family: inherit;
        }

        .container {
            width: min(1180px, calc(100% - 40px));
            margin: auto;
        }


        /* =========================================================
           NAVIGATION
        ========================================================= */

        nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;

            height: 78px;

            display: flex;
            align-items: center;

            z-index: 1000;

            background: linear-gradient(
                to bottom,
                rgba(5,7,11,0.95),
                rgba(5,7,11,0)
            );

            transition: 0.3s;
        }

        nav.scrolled {
            background: rgba(7,9,13,0.92);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid var(--border);
        }

        .nav-inner {
            width: min(1280px, calc(100% - 40px));
            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;

            font-family: "Montserrat", sans-serif;
            font-size: 20px;
            font-weight: 900;
            letter-spacing: -0.5px;
        }

        .brand-icon {
            width: 38px;
            height: 38px;

            border-radius: 10px;

            background:
                linear-gradient(
                    135deg,
                    var(--gold-light),
                    var(--gold-dark)
                );

            display: grid;
            place-items: center;

            color: #171109;
            font-weight: 900;

            box-shadow:
                0 0 30px rgba(245,196,81,0.15);
        }

        .nav-links {
            display: flex;
            gap: 32px;

            color: #c4cad4;
            font-size: 14px;
            font-weight: 600;
        }

        .nav-links a {
            transition: 0.2s;
        }

        .nav-links a:hover {
            color: var(--gold);
        }

        .nav-button {
            padding: 11px 18px;

            border-radius: 9px;

            background: var(--gold);
            color: #171109;

            font-weight: 800;
            font-size: 13px;

            transition: 0.2s;
        }

        .nav-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(245,196,81,0.2);
        }


        /* =========================================================
           HERO
        ========================================================= */

        .hero {
            min-height: 820px;

            position: relative;

            display: flex;
            align-items: center;

            overflow: hidden;

            background:
                linear-gradient(
                    90deg,
                    rgba(5,7,11,0.97) 0%,
                    rgba(5,7,11,0.78) 42%,
                    rgba(5,7,11,0.30) 100%
                ),
                linear-gradient(
                    to bottom,
                    rgba(5,7,11,0.1) 60%,
                    var(--bg) 100%
                ),
                url("https://images.unsplash.com/photo-1607513746994-51f730a44832?auto=format&fit=crop&w=2200&q=90");

            background-size: cover;
            background-position: center;
        }

        .hero::before {
            content: "";

            position: absolute;
            inset: 0;

            background:
                radial-gradient(
                    circle at 65% 45%,
                    rgba(245,196,81,0.12),
                    transparent 35%
                );
        }

        .hero-content {
            position: relative;
            z-index: 2;

            padding-top: 90px;

            max-width: 720px;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            padding: 8px 13px;

            border: 1px solid rgba(245,196,81,0.22);
            background: rgba(245,196,81,0.07);

            border-radius: 999px;

            color: var(--gold-light);

            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.3px;
            text-transform: uppercase;
        }

        .eyebrow::before {
            content: "";
            width: 6px;
            height: 6px;

            border-radius: 50%;

            background: #61e294;

            box-shadow: 0 0 12px #61e294;
        }

        h1 {
            margin-top: 24px;

            font-family: "Montserrat", sans-serif;

            font-size: clamp(58px, 8vw, 100px);

            line-height: 0.9;

            letter-spacing: -5px;

            font-weight: 900;
        }

        h1 span {
            color: var(--gold);
        }

        .hero-subtitle {
            margin-top: 25px;

            max-width: 570px;

            color: #c0c6d0;

            font-size: 19px;
            line-height: 1.7;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;

            gap: 13px;

            margin-top: 35px;
        }

        .btn {
            border: none;

            padding: 15px 23px;

            border-radius: 10px;

            font-size: 14px;
            font-weight: 800;

            cursor: pointer;

            transition: 0.25s;
        }

        .btn-primary {
            background: var(--gold);
            color: #171109;

            box-shadow:
                0 10px 40px rgba(245,196,81,0.15);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow:
                0 15px 50px rgba(245,196,81,0.25);
        }

        .btn-secondary {
            background: rgba(255,255,255,0.07);

            border: 1px solid rgba(255,255,255,0.12);

            color: white;

            backdrop-filter: blur(10px);
        }

        .btn-secondary:hover {
            background: rgba(255,255,255,0.12);
        }

        .server-ip {
            margin-top: 30px;

            display: inline-flex;
            align-items: center;
            gap: 15px;

            padding: 10px 10px 10px 16px;

            border-radius: 12px;

            background: rgba(5,7,11,0.68);

            border: 1px solid rgba(255,255,255,0.1);

            backdrop-filter: blur(15px);
        }

        .server-ip small {
            display: block;

            color: #858e9e;

            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 2px;
        }

        .server-ip strong {
            font-family: monospace;

            color: white;

            font-size: 14px;
        }

        .copy-ip {
            border: none;

            background: rgba(245,196,81,0.14);

            color: var(--gold-light);

            padding: 9px 12px;

            border-radius: 8px;

            cursor: pointer;

            font-size: 11px;
            font-weight: 800;
        }


        /* =========================================================
           STATS
        ========================================================= */

        .stats {
            position: relative;
            z-index: 5;

            margin-top: -70px;
        }

        .stats-inner {
            display: grid;
            grid-template-columns: repeat(3, 1fr);

            background: rgba(13,17,24,0.9);

            border: 1px solid var(--border);

            border-radius: var(--radius);

            backdrop-filter: blur(20px);

            overflow: hidden;
        }

        .stat {
            padding: 28px;

            text-align: center;

            border-right: 1px solid var(--border);
        }

        .stat:last-child {
            border-right: none;
        }

        .stat strong {
            display: block;

            color: var(--gold);

            font-family: "Montserrat", sans-serif;

            font-size: 28px;
        }

        .stat span {
            display: block;

            margin-top: 5px;

            color: var(--muted);

            font-size: 12px;
        }


        /* =========================================================
           SECTION
        ========================================================= */

        section {
            padding: 120px 0;
        }

        .section-heading {
            text-align: center;

            max-width: 680px;

            margin: auto auto 65px;
        }

        .section-label {
            color: var(--gold);

            text-transform: uppercase;

            font-size: 11px;
            font-weight: 900;

            letter-spacing: 2px;
        }

        .section-heading h2 {
            margin-top: 12px;

            font-family: "Montserrat", sans-serif;

            font-size: clamp(36px, 5vw, 58px);

            line-height: 1;

            letter-spacing: -2px;
        }

        .section-heading p {
            margin-top: 18px;

            color: var(--muted);

            line-height: 1.7;
        }


        /* =========================================================
           FEATURES
        ========================================================= */

        .features {
            background:
                radial-gradient(
                    circle at 50% 0%,
                    rgba(245,196,81,0.055),
                    transparent 40%
                );
        }

        .feature-grid {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 18px;
        }

        .feature {
            position: relative;

            min-height: 290px;

            padding: 30px;

            overflow: hidden;

            border-radius: var(--radius);

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,0.055),
                    rgba(255,255,255,0.018)
                );

            border: 1px solid var(--border);

            transition: 0.3s;
        }

        .feature:hover {
            transform: translateY(-6px);

            border-color: rgba(245,196,81,0.25);

            box-shadow:
                0 20px 70px rgba(0,0,0,0.3);
        }

        .feature::after {
            content: "";

            position: absolute;

            width: 180px;
            height: 180px;

            right: -80px;
            bottom: -80px;

            background: var(--gold);

            opacity: 0.04;

            border-radius: 50%;

            filter: blur(20px);
        }

        .feature-icon {
            width: 54px;
            height: 54px;

            display: grid;
            place-items: center;

            border-radius: 14px;

            background: rgba(245,196,81,0.1);

            border: 1px solid rgba(245,196,81,0.13);

            font-size: 25px;
        }

        .feature h3 {
            margin-top: 28px;

            font-family: "Montserrat", sans-serif;

            font-size: 20px;
        }

        .feature p {
            margin-top: 12px;

            color: var(--muted);

            font-size: 14px;

            line-height: 1.7;
        }


        /* =========================================================
           SHOWCASE
        ========================================================= */

        .showcase {
            padding-top: 50px;
        }

        .showcase-card {
            min-height: 540px;

            position: relative;

            display: flex;
            align-items: flex-end;

            overflow: hidden;

            border-radius: 24px;

            background:
                linear-gradient(
                    to top,
                    rgba(5,7,11,0.95),
                    rgba(5,7,11,0.05)
                ),
                url("https://images.unsplash.com/photo-1627856013091-fed6e4e30025?auto=format&fit=crop&w=2200&q=90");

            background-size: cover;
            background-position: center;
        }

        .showcase-content {
            padding: 55px;

            max-width: 680px;
        }

        .showcase-content h2 {
            font-family: "Montserrat", sans-serif;

            font-size: clamp(35px, 5vw, 60px);

            line-height: 1;

            letter-spacing: -2px;
        }

        .showcase-content p {
            margin-top: 20px;

            color: #c3c8d0;

            line-height: 1.7;
        }


        /* =========================================================
           JOIN
        ========================================================= */

        .join {
            text-align: center;

            background:
                radial-gradient(
                    circle at center,
                    rgba(245,196,81,0.1),
                    transparent 45%
                );
        }

        .join-box {
            max-width: 850px;

            margin: auto;

            padding: 70px 30px;

            border-radius: 24px;

            border: 1px solid rgba(245,196,81,0.13);

            background:
                linear-gradient(
                    145deg,
                    rgba(245,196,81,0.05),
                    rgba(255,255,255,0.02)
                );
        }

        .join-box h2 {
            font-family: "Montserrat", sans-serif;

            font-size: clamp(40px, 6vw, 65px);

            letter-spacing: -3px;
        }

        .join-box p {
            margin: 20px auto 30px;

            max-width: 550px;

            color: var(--muted);

            line-height: 1.7;
        }


        /* =========================================================
           HOW TO PLAY
        ========================================================= */

        .steps {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 20px;
        }

        .step {
            text-align: center;

            padding: 35px 25px;

            border-radius: var(--radius);

            border: 1px solid var(--border);

            background: rgba(255,255,255,0.025);
        }

        .step-number {
            width: 48px;
            height: 48px;

            margin: auto;

            display: grid;
            place-items: center;

            border-radius: 50%;

            background: var(--gold);

            color: #171109;

            font-weight: 900;
        }

        .step h3 {
            margin-top: 22px;

            font-family: "Montserrat", sans-serif;
        }

        .step p {
            margin-top: 10px;

            color: var(--muted);

            font-size: 14px;

            line-height: 1.7;
        }


        /* =========================================================
           FAQ
        ========================================================= */

        .faq {
            max-width: 800px;

            margin: auto;
        }

        details {
            margin-bottom: 10px;

            border: 1px solid var(--border);

            border-radius: 12px;

            background: rgba(255,255,255,0.025);

            overflow: hidden;
        }

        summary {
            cursor: pointer;

            padding: 21px;

            font-weight: 700;

            list-style: none;
        }

        summary::-webkit-details-marker {
            display: none;
        }

        summary::after {
            content: "+";

            float: right;

            color: var(--gold);

            font-size: 20px;
        }

        details[open] summary::after {
            content: "−";
        }

        details p {
            padding: 0 21px 21px;

            color: var(--muted);

            font-size: 14px;

            line-height: 1.7;
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        footer {
            padding: 55px 0 30px;

            border-top: 1px solid var(--border);

            background: #05070a;
        }

        .footer-inner {
            display: flex;

            justify-content: space-between;

            align-items: center;
        }

        .footer-brand {
            font-family: "Montserrat", sans-serif;

            font-weight: 900;
        }

        .footer-brand span {
            color: var(--gold);
        }

        .footer-links {
            display: flex;

            gap: 25px;

            color: var(--muted);

            font-size: 13px;
        }

        .copyright {
            margin-top: 35px;

            color: #555d69;

            font-size: 11px;

            text-align: center;
        }


        /* =========================================================
           MOBILE
        ========================================================= */

        @media (max-width: 900px) {

            .nav-links {
                display: none;
            }

            .hero {
                min-height: 720px;

                background-position: 60% center;
            }

            .hero-content {
                padding-top: 80px;
            }

            .feature-grid {
                grid-template-columns: 1fr 1fr;
            }

            .steps {
                grid-template-columns: 1fr;
            }

            .showcase-content {
                padding: 35px;
            }
        }


        @media (max-width: 600px) {

            .container {
                width: min(100% - 28px, 1180px);
            }

            .hero {
                min-height: 700px;

                background-position: 65% center;
            }

            h1 {
                font-size: 58px;
                letter-spacing: -3px;
            }

            .hero-subtitle {
                font-size: 16px;
            }

            .hero-actions {
                flex-direction: column;
            }

            .btn {
                width: 100%;

                text-align: center;
            }

            .server-ip {
                width: 100%;

                justify-content: space-between;
            }

            .stats {
                margin-top: -40px;
            }

            .stats-inner {
                grid-template-columns: 1fr;
            }

            .stat {
                border-right: none;

                border-bottom: 1px solid var(--border);
            }

            .stat:last-child {
                border-bottom: none;
            }

            section {
                padding: 85px 0;
            }

            .feature-grid {
                grid-template-columns: 1fr;
            }

            .feature {
                min-height: auto;
            }

            .showcase-card {
                min-height: 500px;
            }

            .showcase-content {
                padding: 28px;
            }

            .footer-inner {
                flex-direction: column;

                gap: 25px;
            }

            .footer-links {
                flex-wrap: wrap;

                justify-content: center;
            }
        }

    </style>
</head>


<body>


<!-- =========================================================
     NAVIGATION
========================================================= -->

<nav id="navbar">

    <div class="nav-inner">

        <a href="#" class="brand">

            <div class="brand-icon">
                K
            </div>

            MC KINGDOM

        </a>


        <div class="nav-links">

            <a href="#features">Features</a>

            <a href="#play">How To Play</a>

            <a href="#faq">FAQ</a>

            <a href="https://store.mc-kingdom.net">
                Store
            </a>

        </div>


        <a
            href="https://discord.gg/"
            class="nav-button"
            target="_blank"
        >
            DISCORD
        </a>

    </div>

</nav>



<!-- =========================================================
     HERO
========================================================= -->

<header class="hero">

    <div class="container">

        <div class="hero-content">

            <div class="eyebrow">
                Premier Cobblemon Server
            </div>


            <h1>
                BUILD YOUR
                <span>KINGDOM.</span>
            </h1>


            <p class="hero-subtitle">
                A new generation of Cobblemon survival.
                Catch Pokémon, explore a massive world,
                build your kingdom and create your own story.
            </p>


            <div class="hero-actions">

                <a
                    href="#play"
                    class="btn btn-primary"
                >
                    START YOUR ADVENTURE →
                </a>


                <a
                    href="https://discord.gg/"
                    target="_blank"
                    class="btn btn-secondary"
                >
                    JOIN DISCORD
                </a>

            </div>


            <div class="server-ip">

                <div>

                    <small>
                        Server Address
                    </small>

                    <strong id="serverAddress">
                        play.mc-kingdom.net
                    </strong>

                </div>


                <button
                    class="copy-ip"
                    onclick="copyIP()"
                    id="copyButton"
                >
                    COPY IP
                </button>

            </div>

        </div>

    </div>

</header>



<!-- =========================================================
     STATS
========================================================= -->

<div class="stats">

    <div class="container">

        <div class="stats-inner">

            <div class="stat">

                <strong id="playerCount">
                    ONLINE
                </strong>

                <span>
                    Trainers Online
                </span>

            </div>


            <div class="stat">

                <strong>
                    24/7
                </strong>

                <span>
                    Server Availability
                </span>

            </div>


            <div class="stat">

                <strong>
                    1.21.1
                </strong>

                <span>
                    Minecraft Version
                </span>

            </div>

        </div>

    </div>

</div>



<!-- =========================================================
     FEATURES
========================================================= -->

<section
    class="features"
    id="features"
>

    <div class="container">

        <div class="section-heading">

            <div class="section-label">
                What We Offer
            </div>

            <h2>
                MORE THAN
                COBBLEMON.
            </h2>

            <p>
                MC Kingdom is built around progression,
                exploration and community. There's always
                something new to discover.
            </p>

        </div>


        <div class="feature-grid">


            <article class="feature">

                <div class="feature-icon">
                    ⚔️
                </div>

                <h3>
                    Build Your Kingdom
                </h3>

                <p>
                    Create your own base, claim your land,
                    build with friends and turn your
                    corner of the world into something
                    legendary.
                </p>

            </article>



            <article class="feature">

                <div class="feature-icon">
                    🐉
                </div>

                <h3>
                    Hunt Rare Pokémon
                </h3>

                <p>
                    Explore the world in search of rare
                    Pokémon, powerful teams and legendary
                    encounters.
                </p>

            </article>



            <article class="feature">

                <div class="feature-icon">
                    🏆
                </div>

                <h3>
                    Battle & Compete
                </h3>

                <p>
                    Train your team, challenge other
                    trainers and take part in community
                    tournaments and events.
                </p>

            </article>



            <article class="feature">

                <div class="feature-icon">
                    💰
                </div>

                <h3>
                    Player Economy
                </h3>

                <p>
                    Trade Pokémon, earn currency and
                    build your fortune through a
                    player-driven economy.
                </p>

            </article>



            <article class="feature">

                <div class="feature-icon">
                    🌎
                </div>

                <h3>
                    Explore
                </h3>

                <p>
                    Discover a huge survival world filled
                    with interesting locations, Pokémon,
                    resources and secrets.
                </p>

            </article>



            <article class="feature">

                <div class="feature-icon">
                    🎉
                </div>

                <h3>
                    Community Events
                </h3>

                <p>
                    Take part in server events, giveaways,
                    competitions and activities with the
                    Kingdom community.
                </p>

            </article>

        </div>

    </div>

</section>



<!-- =========================================================
     SHOWCASE
========================================================= -->

<section class="showcase">

    <div class="container">

        <div class="showcase-card">

            <div class="showcase-content">

                <div class="section-label">
                    Your Adventure
                </div>

                <h2>
                    YOUR WORLD.
                    YOUR KINGDOM.
                </h2>

                <p>
                    Whether you're here to collect every
                    Pokémon, build an incredible kingdom,
                    battle your friends or simply explore,
                    MC Kingdom gives you the freedom to
                    play your way.
                </p>

                <br>

                <a
                    href="#play"
                    class="btn btn-primary"
                >
                    BEGIN YOUR JOURNEY
                </a>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     HOW TO PLAY
========================================================= -->

<section id="play">

    <div class="container">

        <div class="section-heading">

            <div class="section-label">
                Getting Started
            </div>

            <h2>
                READY TO PLAY?
            </h2>

            <p>
                Getting into MC Kingdom is simple.
            </p>

