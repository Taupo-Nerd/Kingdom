<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MC Kingdom | Premier Cobblemon Server</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #07090d;
    color: white;
    overflow-x: hidden;
}

a {
    text-decoration: none;
    color: inherit;
}

.container {
    width: min(1200px, 90%);
    margin: auto;
}

/* NAV */

nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 76px;
    z-index: 1000;

    display: flex;
    align-items: center;

    background: rgba(5,7,10,.75);
    backdrop-filter: blur(16px);

    border-bottom: 1px solid rgba(255,255,255,.08);
}

.nav-inner {
    width: min(1250px, 90%);
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 21px;
    font-weight: 900;
    letter-spacing: 1px;
}

.logo span {
    color: #f4c451;
}

.links {
    display: flex;
    gap: 30px;
}

.links a {
    color: #b8c0cc;
    font-size: 14px;
    font-weight: 700;
}

.links a:hover {
    color: #f4c451;
}

.discord {
    background: #f4c451;
    color: #111;
    padding: 11px 18px;
    border-radius: 8px;
    font-weight: 900;
    font-size: 13px;
}

/* HERO */

.hero {
    min-height: 900px;

    display: flex;
    align-items: center;

    position: relative;

    background:
        linear-gradient(
            90deg,
            rgba(4,6,9,.98) 0%,
            rgba(4,6,9,.88) 35%,
            rgba(4,6,9,.35) 75%,
            rgba(4,6,9,.65) 100%
        ),
        linear-gradient(
            0deg,
            #07090d 0%,
            transparent 40%
        ),
        url("https://images.unsplash.com/photo-1607513746994-51f730a44832?auto=format&fit=crop&w=2400&q=90");

    background-size: cover;
    background-position: center;
}

.hero-content {
    max-width: 720px;
    padding-top: 80px;
}

.badge {
    display: inline-block;

    padding: 9px 15px;

    border-radius: 50px;

    background: rgba(244,196,81,.1);

    border: 1px solid rgba(244,196,81,.25);

    color: #ffe69c;

    font-size: 11px;
    font-weight: 900;

    letter-spacing: 2px;
    text-transform: uppercase;
}

h1 {
    margin-top: 25px;

    font-size: clamp(58px, 9vw, 105px);

    line-height: .88;

    letter-spacing: -6px;

    font-weight: 900;
}

h1 span {
    color: #f4c451;
}

.hero-text {
    margin-top: 28px;

    max-width: 600px;

    color: #c5cbd5;

    font-size: 19px;
    line-height: 1.7;
}

.buttons {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;

    margin-top: 35px;
}

.button {
    display: inline-block;

    padding: 15px 24px;

    border-radius: 9px;

    font-size: 13px;
    font-weight: 900;

    transition: .25s;
}

.button:hover {
    transform: translateY(-3px);
}

.primary {
    background: #f4c451;
    color: #111;

    box-shadow: 0 12px 40px rgba(244,196,81,.2);
}

.secondary {
    background: rgba(255,255,255,.08);

    border: 1px solid rgba(255,255,255,.14);
}

.server {
    display: inline-flex;
    align-items: center;
    gap: 18px;

    margin-top: 30px;

    padding: 12px 12px 12px 18px;

    background: rgba(0,0,0,.55);

    border: 1px solid rgba(255,255,255,.1);

    border-radius: 10px;

    backdrop-filter: blur(15px);
}

.server small {
    display: block;

    color: #818a99;

    font-size: 9px;

    letter-spacing: 1.5px;

    text-transform: uppercase;
}

.server strong {
    font-family: monospace;

    font-size: 15px;
}

.copy {
    border: 0;

    padding: 10px 13px;

    border-radius: 7px;

    background: rgba(244,196,81,.15);

    color: #f4c451;

    cursor: pointer;

    font-size: 10px;
    font-weight: 900;
}

/* STATS */

.stats {
    margin-top: -70px;

    position: relative;
    z-index: 10;
}

.stats-box {
    display: grid;
    grid-template-columns: repeat(3,1fr);

    background: rgba(15,19,27,.94);

    border: 1px solid rgba(255,255,255,.08);

    border-radius: 18px;

    overflow: hidden;

    backdrop-filter: blur(20px);
}

.stat {
    padding: 30px;

    text-align: center;

    border-right: 1px solid rgba(255,255,255,.08);
}

.stat:last-child {
    border: 0;
}

.stat strong {
    display: block;

    color: #f4c451;

    font-size: 29px;
    font-weight: 900;
}

.stat span {
    display: block;

    margin-top: 6px;

    color: #858e9e;

    font-size: 12px;
}

/* GENERAL SECTIONS */

section {
    padding: 120px 0;
}

.heading {
    max-width: 700px;

    margin: auto auto 60px;

    text-align: center;
}

.heading-label {
    color: #f4c451;

    font-size: 10px;
    font-weight: 900;

    letter-spacing: 2px;
    text-transform: uppercase;
}

.heading h2 {
    margin-top: 12px;

    font-size: clamp(38px,5vw,60px);

    line-height: 1;

    letter-spacing: -3px;
}

.heading p {
    margin-top: 18px;

    color: #858e9e;

    line-height: 1.7;
}

/* FEATURES */

.features {
    background:
        radial-gradient(
            circle at top,
            rgba(244,196,81,.06),
            transparent 45%
        );
}

.feature-grid {
    display: grid;

    grid-template-columns: repeat(3,1fr);

    gap: 18px;
}

.feature {
    min-height: 280px;

    padding: 32px;

    border-radius: 18px;

    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.055),
            rgba(255,255,255,.015)
        );

    border: 1px solid rgba(255,255,255,.08);

    transition: .3s;
}

.feature:hover {
    transform: translateY(-7px);

    border-color: rgba(244,196,81,.3);

    box-shadow: 0 25px 70px rgba(0,0,0,.35);
}

.icon {
    width: 55px;
    height: 55px;

    display: grid;
    place-items: center;

    border-radius: 14px;

    background: rgba(244,196,81,.1);

    border: 1px solid rgba(244,196,81,.15);

    font-size: 25px;
}

.feature h3 {
    margin-top: 25px;

    font-size: 20px;
}

.feature p {
    margin-top: 12px;

    color: #858e9e;

    font-size: 14px;

    line-height: 1.7;
}

/* SHOWCASE */

.showcase {
    padding-top: 30px;
}

.showcase-box {
    min-height: 560px;

    display: flex;
    align-items: flex-end;

    overflow: hidden;

    border-radius: 24px;

    background:
        linear-gradient(
            0deg,
            rgba(3,5,8,.98),
            rgba(3,5,8,.05)
        ),
        url("https://images.unsplash.com/photo-1627856013091-fed6e4e30025?auto=format&fit=crop&w=2400&q=90");

    background-size: cover;
    background-position: center;
}

.showcase-content {
    max-width: 700px;

    padding: 55px;
}

.showcase-content h2 {
    margin-top: 10px;

    font-size: clamp(40px,5vw,65px);

    line-height: .95;

    letter-spacing: -4px;
}

.showcase-content p {
    margin-top: 20px;

    color: #c2c8d2;

    line-height: 1.7;
}

/* STEPS */

.steps {
    display: grid;

    grid-template-columns: repeat(3,1fr);

    gap: 20px;
}

.step {
    padding: 35px 25px;

    text-align: center;

    background: rgba(255,255,255,.025);

    border: 1px solid rgba(255,255,255,.08);

    border-radius: 18px;
}

.number {
    width: 50px;
    height: 50px;

    margin: auto;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: #f4c451;

    color: #111;

    font-weight: 900;
}

.step h3 {
    margin-top: 22px;
}

.step p {
    margin-top: 12px;

    color: #858e9e;

    font-size: 14px;

    line-height: 1.7;
}

/* JOIN */

.join {
    text-align: center;

    background:
        radial-gradient(
            circle at center,
            rgba(244,196,81,.1),
            transparent 50%
        );
}

.join-box {
    padding: 75px 30px;

    border-radius: 24px;

    background: rgba(255,255,255,.025);

    border: 1px solid rgba(244,196,81,.15);
}

.join-box h2 {
    margin-top: 10px;

    font-size: clamp(42px,6vw,70px);

    letter-spacing: -4px;
}

.join-box p {
    max-width: 600px;

    margin: 20px auto 0;

    color: #858e9e;

    line-height: 1.7;
}

/* FAQ */

.faq {
    max-width: 850px;

    margin: auto;
}

details {
    margin-bottom: 10px;

    background: rgba(255,255,255,.025);

    border: 1px solid rgba(255,255,255,.08);

    border-radius: 12px;
}

summary {
    padding: 21px;

    cursor: pointer;

    font-weight: 700;

    list-style: none;
}

summary::-webkit-details-marker {
    display: none;
}

summary::after {
    content: "+";

    float: right;

    color: #f4c451;

    font-size: 20px;
}

details[open] summary::after {
    content: "−";
}

details p {
    padding: 0 21px 21px;

    color: #858e9e;

    font-size: 14px;

    line-height: 1.7;
}

/* FOOTER */

footer {
    padding: 55px 0 30px;

    background: #05070a;

    border-top: 1px solid rgba(255,255,255,.08);
}

.footer {
    display: flex;

    align-items: center;

    justify-content: space-between;
}

.footer-logo {
    font-weight: 900;
}

.footer-logo span {
    color: #f4c451;
}

.footer-links {
    display: flex;

    gap: 25px;

    color: #737c8a;

    font-size: 13px;
}

.copyright {
    margin-top: 35px;

    color: #454d58;

    font-size: 11px;

    text-align: center;
}

/* MOBILE */

@media(max-width:850px) {

    .links {
        display: none;
    }

    .feature-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .steps {
        grid-template-columns: 1fr;
    }
}

@media(max-width:600px) {

    .hero {
        min-height: 760px;
    }

